---
import AppLayout from '../../layouts/AppLayout.astro';
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo.png';
import { ensureCsrfToken } from '../../lib/server/security';

export const prerender = false;

const url = new URL(Astro.request.url);
const errorCode = url.searchParams.get('error') || '';
const csrf = ensureCsrfToken(Astro.cookies);
const errorMessages: Record<string, string> = {
  email_already_exists: 'An account already exists for this email.',
  legal_acceptance_required: 'Accept the Terms of Use and Privacy Policy to continue.',
  validation_error: 'Please check the entered information.',
  rate_limit_exceeded: 'Too many attempts. Please wait and try again.',
  request_rejected: 'The request could not be verified. Refresh and try again.',
  backend_unavailable: 'Elyan is temporarily unavailable. Please try again.',
};
const errorMsg = errorCode ? errorMessages[errorCode] || 'Registration could not be completed.' : '';
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';
const appleServiceId = import.meta.env.PUBLIC_APPLE_SERVICE_ID || '';
const appleRedirectUri = import.meta.env.PUBLIC_APPLE_REDIRECT_URI || '';
---

<AppLayout title="Register - Elyan">
  <div class="flex-1 flex items-center justify-center relative overflow-y-auto bg-[var(--color-elyan-bg)] px-4" data-auth-mode="register" data-google-client-id={googleClientId} data-apple-service-id={appleServiceId} data-apple-redirect-uri={appleRedirectUri}>
    <!-- Register card -->
    <div class="relative z-10 w-full max-w-md bg-[var(--color-elyan-surface)] border border-[var(--color-elyan-outline)] p-10 rounded-[28px] shadow-[0_8px_30px_rgb(0,0,0,0.04)] my-12">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-[20px] bg-[var(--color-elyan-surface-muted)] border border-[var(--color-elyan-outline)] shadow-sm mb-6">
          <Image src={logoImage} alt="Elyan Logo" width={32} height={32} class="w-8 h-auto" />
        </div>
        <h1 class="text-3xl font-sans font-bold text-[var(--color-elyan-text)] tracking-tight">Create Account</h1>
        <p class="text-[var(--color-elyan-text-muted)] mt-2 text-sm font-medium">Join Elyan and elevate your workflow</p>
      </div>

      {errorMsg && (
        <div class="mb-6 p-4 rounded-[16px] bg-[var(--color-elyan-danger)]/10 border border-[var(--color-elyan-danger)]/20 text-[var(--color-elyan-danger)] text-sm font-medium text-center">
          {errorMsg}
        </div>
      )}

      <form action="/app/api/auth/register" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value={csrf} />
        <div>
          <label for="displayName" class="block text-sm font-semibold text-[var(--color-elyan-text)] mb-1.5">Full Name</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--color-elyan-text-muted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <input type="text" name="displayName" id="displayName" class="block w-full pl-11 pr-3 py-3.5 border border-transparent rounded-[16px] bg-[var(--color-elyan-surface-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-elyan-primary-soft)] focus:border-[var(--color-elyan-outline)] text-[var(--color-elyan-text)] placeholder-[var(--color-elyan-text-muted)] transition-all text-sm font-medium" required>
          </div>
        </div>

        <div class="space-y-3 text-xs leading-relaxed text-[var(--color-elyan-text-muted)]">
          <label class="flex items-start gap-2.5">
            <input type="checkbox" name="termsAccepted" class="mt-0.5 rounded border-[var(--color-elyan-outline)] text-[var(--color-elyan-primary)] focus:ring-[var(--color-elyan-primary-soft)]" required />
            <span>I accept the <a href="/kullanim-kosullari" target="_blank" class="text-[var(--color-elyan-primary)] underline underline-offset-2">Terms of Use</a>.</span>
          </label>
          <label class="flex items-start gap-2.5">
            <input type="checkbox" name="privacyAccepted" class="mt-0.5 rounded border-[var(--color-elyan-outline)] text-[var(--color-elyan-primary)] focus:ring-[var(--color-elyan-primary-soft)]" required />
            <span>I accept the <a href="/gizlilik" target="_blank" class="text-[var(--color-elyan-primary)] underline underline-offset-2">Privacy Policy</a>.</span>
          </label>
          <label class="flex items-start gap-2.5">
            <input type="checkbox" name="aiDataSharingAccepted" class="mt-0.5 rounded border-[var(--color-elyan-outline)] text-[var(--color-elyan-primary)] focus:ring-[var(--color-elyan-primary-soft)]" />
            <span>I consent to optional AI data sharing described in the notice.</span>
          </label>
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-[var(--color-elyan-text)] mb-1.5">Email</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--color-elyan-text-muted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <input type="email" name="email" id="email" class="block w-full pl-11 pr-3 py-3.5 border border-transparent rounded-[16px] bg-[var(--color-elyan-surface-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-elyan-primary-soft)] focus:border-[var(--color-elyan-outline)] text-[var(--color-elyan-text)] placeholder-[var(--color-elyan-text-muted)] transition-all text-sm font-medium" required>
          </div>
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold text-[var(--color-elyan-text)] mb-1.5">Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--color-elyan-text-muted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <input type="password" name="password" id="password" class="block w-full pl-11 pr-3 py-3.5 border border-transparent rounded-[16px] bg-[var(--color-elyan-surface-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-elyan-primary-soft)] focus:border-[var(--color-elyan-outline)] text-[var(--color-elyan-text)] placeholder-[var(--color-elyan-text-muted)] transition-all text-sm font-medium" required minlength="8">
          </div>
        </div>

        <button type="submit" class="w-full mt-2 flex justify-center py-3.5 px-4 rounded-[16px] text-[14.5px] font-bold text-white bg-[var(--color-elyan-primary)] hover:bg-[var(--color-elyan-primary-dark)] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[var(--color-elyan-bg)] focus:ring-[var(--color-elyan-primary)] transition-all shadow-sm">
          Create Account
        </button>
      </form>

      <div class="mt-6">
        <div class="flex items-center gap-3 text-xs text-[var(--color-elyan-text-muted)]"><span class="h-px flex-1 bg-[var(--color-elyan-outline)]"></span><span>or continue with</span><span class="h-px flex-1 bg-[var(--color-elyan-outline)]"></span></div>
        <div class="mt-4 space-y-3">
          <div id="google-signin" class="flex min-h-10 justify-center"></div>
          <button id="apple-signin" type="button" class="w-full flex min-h-11 items-center justify-center rounded-full bg-black px-4 text-sm font-semibold text-white hover:bg-zinc-800 disabled:opacity-50">Sign up with Apple</button>
        </div>
        <p id="social-auth-status" aria-live="polite" class="hidden mt-3 text-center text-xs text-[var(--color-elyan-text-muted)]"></p>
      </div>

      <div class="mt-8 text-center text-sm font-medium text-[var(--color-elyan-text-muted)]">
        Already have an account? <a href="/app/login" class="text-[var(--color-elyan-primary)] hover:underline underline-offset-4">Sign in</a>
      </div>
    </div>
  </div>
</AppLayout>

<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
<script is:inline src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js" async></script>
<script>
  import { initSocialAuth } from '../../lib/client/auth-social';
  initSocialAuth();
</script>
