---
import '../assets/styles/global.css';
import '@fontsource/bodoni-moda';
import '@fontsource/manrope';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Elyan', description = 'A modern web application' } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      html, body {
        font-family: 'Manrope', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Bodoni Moda', serif;
      }
    </style>
  </head>
  <body>
    <slot />
    
    <script>
      import Lenis from 'lenis';
      
      const lenis = new Lenis({
        autoRaf: true,
      });
      
      // Request animation frame for lenis is handled by autoRaf: true in newer versions
    </script>
  </body>
</html>
