---
interface Props { active: 'profile' | 'devices' | 'billing' | 'integrations' }
const { active } = Astro.props;
const links = [
  { key: 'profile', href: '/app/settings', label: 'Profile', icon: 'M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8' },
  { key: 'devices', href: '/app/settings/devices', label: 'Devices', icon: 'M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5 M8 21h8 M12 17v4' },
  { key: 'billing', href: '/app/settings/billing', label: 'Billing', icon: 'M2 5h20v14H2z M2 10h20' },
  { key: 'integrations', href: '/app/settings/integrations', label: 'Integrations', icon: 'M8 12h8 M12 8v8 M5 5l14 14 M19 5 5 19' },
] as const;
---

<aside class="w-[260px] flex-none bg-transparent border-r border-[var(--color-elyan-outline)]/55 flex flex-col transition-transform duration-300 max-md:w-full max-md:border-r-0 max-md:border-b max-md:border-[var(--color-elyan-outline)]/55">
  <div class="h-14 px-5 flex items-center">
    <a href="/app" class="flex items-center gap-2 text-[var(--color-elyan-text-muted)] hover:text-[var(--color-elyan-text)] transition-colors">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      <span class="text-sm font-medium tracking-wide">Back to Chat</span>
    </a>
  </div>
  <nav class="p-4 max-md:flex max-md:gap-1.5 max-md:overflow-x-auto" aria-label="Settings">
    <div class="text-[11px] font-semibold text-[var(--color-elyan-text-muted)] uppercase tracking-wider px-2 mb-2 max-md:hidden">Account</div>
    {links.map((link) => <a href={link.href} aria-current={active === link.key ? 'page' : undefined} class:list={[
      'flex items-center gap-3 px-3 py-2 rounded-full text-sm transition-colors mt-1 max-md:flex-none active:scale-95',
      active === link.key
        ? 'bg-[var(--color-elyan-primary-soft)] text-[var(--color-elyan-primary-dark)] font-medium'
        : 'hover:bg-[var(--color-elyan-surface-muted)] text-[var(--color-elyan-text-muted)] hover:text-[var(--color-elyan-text)]',
    ]}>
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={link.icon}></path></svg>
      {link.label}
    </a>)}
  </nav>
</aside>
