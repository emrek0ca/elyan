---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`card-spread-container relative w-[16rem] h-[22rem] cursor-pointer flex items-center justify-center ${className}`}>
  <!-- 5 Cards -->
  {Array.from({ length: 5 }).map((_, i) => (
    <div 
      class="card-spread-item absolute inset-0 rounded-2xl border border-[var(--color-elyan-outline)] bg-[var(--color-elyan-surface)] shadow-md flex items-center justify-center overflow-hidden"
      data-index={i}
      style={`z-index: ${3 - Math.abs(i - 2)}; transform-origin: 50% 100%;`}
    >
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[var(--color-elyan-bg-deep)] opacity-50"></div>
      <div class="relative z-10 text-[var(--color-elyan-text-muted)] font-bodoni text-4xl opacity-20">{i + 1}</div>
    </div>
  ))}
</div>

<script>
  import { gsap } from 'gsap';

  const initCardSpread = () => {
    const containers = document.querySelectorAll('.card-spread-container');
    
    containers.forEach(container => {
      const cards = container.querySelectorAll('.card-spread-item');
      const center = 2;
      const angle = 30;
      const gap = 70;
      const yOffset = 10;

      container.addEventListener('mouseenter', () => {
        cards.forEach((card, i) => {
          const dist = i - center;
          const targetRotate = dist * (angle / center);
          const targetX = dist * (gap / center);
          
          let targetY = 0;
          if (Math.abs(dist) === 2) targetY = yOffset;
          else if (Math.abs(dist) === 1) targetY = -0.2 * yOffset;
          else targetY = -yOffset;

          gsap.to(card, {
            rotate: targetRotate,
            x: targetX,
            y: targetY,
            scale: dist === 0 ? 1.05 : 1,
            duration: 0.5,
            ease: 'back.out(1.5)',
            overwrite: true
          });
        });
      });

      container.addEventListener('mouseleave', () => {
        cards.forEach(card => {
          gsap.to(card, {
            rotate: 0,
            x: 0,
            y: 0,
            scale: 1,
            duration: 0.5,
            ease: 'power3.out',
            overwrite: true
          });
        });
      });
    });
  };

  initCardSpread();
</script>
