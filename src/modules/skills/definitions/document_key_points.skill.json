{
  "id": "document_key_points",
  "version": "1.1.0",
  "active": true,
  "name": "Document Key Points",
  "displayName": "Önemli Noktalar",
  "displayDescription": "Belgedeki kararları, tarihleri, sorumluları ve aksiyonları çıkarır.",
  "slashCommand": "/önemli-noktalar",
  "uiCategory": "document",
  "requiresAttachment": true,
  "supportedMimeTypes": ["application/pdf", "text/plain", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
  "manualSelectable": true,
  "purpose": "Extract important points and action items from mobile-extracted document chunks.",
  "summary": "Finds key points, decisions, obligations, dates, and action items in an attachment.",
  "instructions": "Use only the selected attachment chunks. Focus on important points, decisions, deadlines, responsibilities, and action items. Return strict JSON only.",
  "triggers": {
    "phrases": ["önemli noktalar", "onemli noktalar", "ana noktalar", "maddeler", "aksiyon", "action item", "key points", "çıkarılacaklar"],
    "intents": ["key_points", "action_items", "extract"],
    "payloadTypes": ["application/pdf", "text/plain", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
  },
  "inputSchema": {
    "type": "object",
    "required": ["prompt", "chunks"],
    "properties": {
      "prompt": { "type": "string", "minLength": 1 },
      "chunks": { "type": "array", "minItems": 1 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "keyPoints", "actionItems", "confidence"],
    "properties": {
      "title": { "type": "string", "minLength": 1 },
      "keyPoints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "actionItems": { "type": "array", "items": { "type": "string" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  },
  "produces": {
    "desiredOutputKinds": ["chat_reply", "pdf", "docx", "artifact"],
    "artifactTypes": ["document"],
    "blockTypes": ["document_block"]
  },
  "allowedTools": [],
  "modelProfile": "document_reasoning",
  "maxInputTokens": 2400,
  "maxOutputTokens": 500,
  "timeoutMs": 6500,
  "cachePolicy": { "enabled": true, "ttlMs": 300000 },
  "validation": { "requireJson": true, "repairAttempts": 1, "rejectEmptyOutput": true, "minConfidence": 0.5 }
}
