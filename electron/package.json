{
  "name": "elyan-electron-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Elyan, backed by the existing Python runtime bridge.",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "dev": "node ./scripts/dev.mjs",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:preview": "vite preview --config vite.renderer.config.ts",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "build": "npm run clean && npm run build:renderer && npm run build:main && npm run build:preload && npm run build:runtime && npm run build:native",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:native": "node ./scripts/build-native.mjs",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "package": "npm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.2.0",
    "node-addon-api": "^8.8.0",
    "node-gyp": "^12.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
