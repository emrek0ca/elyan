{
  "name": "elyan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin backend/control-plane for Elyan mobile to desktop runtime orchestration",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "training:worker": "tsx src/workers/training-worker.ts",
    "brain:benchmark": "tsx src/modules/brain/benchmark-cli.ts",
    "brain:seed-corpus": "node dist/scripts/seed-brain-corpus.js",
    "brain:seed-corpus:src": "tsx src/scripts/seed-brain-corpus.ts",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test $(find dist -name '*.test.js' -type f | sort)",
    "db:generate": "npm run build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "npm run build && drizzle-kit push"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1070.0",
    "@aws-sdk/s3-request-presigner": "^3.1070.0",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@fastify/compress": "^9.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.0.2",
    "@huggingface/transformers": "^4.2.0",
    "ajv": "^8.20.0",
    "bullmq": "^5.77.7",
    "drizzle-orm": "^0.45.2",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "franc-min": "^6.2.0",
    "ioredis": "^5.11.0",
    "jose": "^5.10.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
