{
  "name": "elyan",
  "productName": "Elyan",
  "version": "1.5.0",
  "description": "Elyan masaüstü ajanı — npm install -g elyan && elyan. Mobilden gelen görevleri bilgisayarında yürütür.",
  "bin": {
    "elyan": "bin/elyan.js"
  },
  "files": [
    "bin/elyan.js",
    "cli/",
    "runtime/",
    "core/",
    "actions/",
    "helpers/",
    "config/api_keys.example.json",
    "resources/",
    "app_config.py",
    "__init__.py",
    "__main__.py",
    "scripts/install_extras.py",
    "requirements-core.txt",
    "requirements.txt",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build:runtime": "node ./scripts/build-runtime.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  }
}
