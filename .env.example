NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Use the canonical public API origin in production.
APP_BASE_URL=https://api.elyan.dev
# For host-run backend use 127.0.0.1. The docker-compose backend service overrides
# this to the internal postgres hostname automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/elyan_backend
DATABASE_APP_URL=
POSTGRES_APP_PASSWORD=
DATABASE_WORKER_URL=
POSTGRES_WORKER_PASSWORD=
JWT_SECRET=change-me-please-1234
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
RUNTIME_TOKEN_TTL=12h
PAIRING_TTL_MINUTES=10
RUNTIME_SECRET_PEPPER=change-me-runtime-pepper-1234
CORS_ORIGIN=*
# Redis is required in production for shared control-plane reliability state.
REDIS_URL=redis://127.0.0.1:6379
RELIABILITY_REDIS_REQUIRED=false
RATE_LIMIT_REDIS_ENABLED=false
REALTIME_REDIS_FANOUT_ENABLED=true
REALTIME_REDIS_CHANNEL_PREFIX=elyan:realtime
REALTIME_EVENT_RETENTION_HOURS=48
SSE_MAX_STREAMS_PER_USER=4
SSE_REPLAY_LIMIT=500
SSE_HEARTBEAT_MS=15000
BRAIN_CIRCUIT_FAILURE_THRESHOLD=3
BRAIN_CIRCUIT_OPEN_MS=30000
TASK_DISPATCH_LOCK_TTL_MS=120000
REQUEST_BUDGET_WINDOW_MS=60000
AUTH_REQUEST_BUDGET_MAX=10
CHAT_REQUEST_BUDGET_MAX=60
TASK_REQUEST_BUDGET_MAX=60
GOOGLE_CLIENT_ID=762420924659-8necsbtt40deelcpo797ald54o50q0uo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Use a separate Web OAuth client per Google MCP resource so scopes and
# revocation stay isolated. All three use the backend callback URL documented below.
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=
GOOGLE_DRIVE_MCP_CLIENT_ID=
GOOGLE_DRIVE_MCP_CLIENT_SECRET=
GOOGLE_CALENDAR_MCP_CLIENT_ID=
GOOGLE_CALENDAR_MCP_CLIENT_SECRET=
GOOGLE_SERVER_CLIENT_ID=762420924659-heq7v2qm19kqt9tj8tt14fef9u7s4dgh.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.762420924659-8necsbtt40deelcpo797ald54o50q0uo
# Curated remote MCP OAuth applications. Leave blank to show the app as unavailable.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# App ID bundle identifier for native iOS Sign in with Apple token validation.
APPLE_CLIENT_ID=com.elyan.elyanMobile
# Services ID for Android/web Apple sign-in flows.
APPLE_SERVICE_ID=com.elyan.web
# App Store Server API / Notifications V2. Keep the private key outside git.
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_PRIVATE_KEY=
APPLE_APP_STORE_PRIVATE_KEY_PATH=
APPLE_APP_BUNDLE_ID=com.elyan.elyanMobile
APPLE_APP_ID=
APPLE_SOLO_PRODUCT_ID=com.elyan.elyanMobile.solo.monthly
APPLE_PRO_PRODUCT_ID=com.elyan.elyanMobile.pro.monthly
# APNs signing key for production push delivery. Keep the private key outside git.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=production
# Leave blank only if you intentionally want billing checkout surfaces to stay degraded.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://api.iyzipay.com
# In production this must be a public HTTPS origin.
IYZICO_PUBLIC_BASE_URL=https://api.example.com
IYZICO_LOCALE=tr
IYZICO_PRODUCT_NAME=Elyan Subscriptions
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Enable only after the account/project is verified for the required sensitive-data controls.
GROQ_VISION_SENSITIVE_DATA_ATTESTED=false
# Groq Compound (agentic system: built-in web search + code execution).
# Disabled by default. When true, web/recency-heavy workloads (planning,
# deep-refine) try compound first and fall back to the gpt-oss chain, so
# quality never regresses. Document/vision workloads are excluded for privacy.
GROQ_COMPOUND_ENABLED=false
GROQ_COMPOUND_MODEL=groq/compound
GROQ_COMPOUND_MINI_MODEL=groq/compound-mini
# Optional search tuning passed to compound_custom.search_settings.
# Comma-separated domain lists + an ISO-3166 country hint.
GROQ_COMPOUND_SEARCH_COUNTRY=
GROQ_COMPOUND_INCLUDE_DOMAINS=
GROQ_COMPOUND_EXCLUDE_DOMAINS=
# Production compose enables the durable chat queue and starts two chat-worker
# replicas. Keep this false only for the documented synchronous rollback path.
ELYAN_CHAT_QUEUE_ENABLED=true
ELYAN_CHAT_WORKER_CONCURRENCY=4
ELYAN_CHAT_PRIMARY_GLOBAL_CONCURRENCY=6
ELYAN_CHAT_FALLBACK_GLOBAL_CONCURRENCY=4
ELYAN_CHAT_GLOBAL_BACKLOG_MAX=1000
ELYAN_CHAT_USER_BACKLOG_MAX=3
ELYAN_GROQ_RPM_LIMIT=30
ELYAN_GROQ_TPM_LIMIT=8000
ELYAN_GEMINI_RPM_LIMIT=10
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_INTERACTIONS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_VISION_SENSITIVE_DATA_ATTESTED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_PRO_ENABLED=false
GEMINI_IMAGE_DAILY_GLOBAL_LIMIT=50
GEMINI_IMAGE_PRO_DAILY_GLOBAL_LIMIT=5
GEMINI_IMAGE_4K_DAILY_GLOBAL_LIMIT=2
ELYAN_GEMINI_FREE_FEATURES_ENABLED=true
# Free-only helper calls never leave this explicit model allowlist. Keep this
# aligned with the free tier available to the Google project in use.
GEMINI_FREE_ONLY=true
# Set true only after accepting the Google free-tier data-use terms for the
# non-sensitive cloud content routed through these helper calls.
GEMINI_FREE_DATA_USAGE_ATTESTED=false
# Paid fallback remains fail-closed unless billing and the data-processing
# conditions have both been verified for the configured project.
GEMINI_PAID_FALLBACK_ENABLED=false
GEMINI_PAID_DATA_PROCESSING_ATTESTED=false
GEMINI_FREE_MODEL_ALLOWLIST=gemini-3.1-flash-lite
GEMINI_FREE_DAILY_REQUEST_LIMIT=200
GEMINI_FREE_DAILY_INPUT_TOKEN_LIMIT=250000
GEMINI_FREE_DAILY_OUTPUT_TOKEN_LIMIT=50000
GEMINI_FREE_USER_DAILY_REQUEST_LIMIT=25
GEMINI_FREE_UTILITY_SAMPLE_PERCENT=10
ELYAN_SHARED_BRAIN_PROVIDER=groq
ELYAN_SHARED_BRAIN_BASE_URL=https://api.groq.com/openai/v1
# Optional fallback provider, used when the primary shared brain target is unhealthy.
ELYAN_SHARED_BRAIN_FALLBACK_PROVIDER=
ELYAN_SHARED_BRAIN_FALLBACK_BASE_URL=
ELYAN_SHARED_BRAIN_MODEL=openai/gpt-oss-120b
ELYAN_SHARED_BRAIN_FAST_MODEL=openai/gpt-oss-20b
ELYAN_SHARED_BRAIN_BALANCED_MODEL=openai/gpt-oss-120b
ELYAN_SHARED_BRAIN_PLANNING_MODEL=openai/gpt-oss-120b
ELYAN_SHARED_BRAIN_KEEP_ALIVE=30m
ELYAN_WEB_GROUNDING_ENABLED=true
ELYAN_WEB_SEARCH_BASE_URL=https://html.duckduckgo.com/html/
ELYAN_WEB_GROUNDING_MAX_RESULTS=4
ELYAN_WEB_GROUNDING_TIMEOUT_MS=6500
ELYAN_RAG_SEMANTIC_RERANK_ENABLED=true
ELYAN_SEMANTIC_COMPUTE_WORKER_ENABLED=true
ELYAN_RAG_SEMANTIC_RERANK_MODEL=Xenova/multilingual-e5-small
ELYAN_RAG_SEMANTIC_RERANK_WINDOW=8
ELYAN_SHARED_BRAIN_SYSTEM_PROMPT=You are Elyan, a local-first assistant developed by Osman Emre Koca. Speak as Elyan, not as a generic chatbot. Act like a senior AI engineer: be concise, grounded, and explicit about architecture, failure modes, verification, tradeoffs, and operational safety. Prefer Turkish unless the user writes in another language. If asked who built you or what you are, say Elyan developed by Osman Emre Koca. Do not mention other AI brands or model names unless the user explicitly asks about implementation details. Never invent readiness, capabilities, or results. If uncertain, say so and suggest the smallest reliable verification step. Never reveal secrets, hostnames, API paths, private data, or hidden reasoning. If a request clearly requires a paired desktop runtime, say so briefly.
ELYAN_USER_UNDERSTANDING_ENABLED=true
ELYAN_PERSONALIZATION_ENABLED=true
ELYAN_WORLD_CONTEXT_PACKETS_ENABLED=true
ELYAN_LEARNING_EXTRACTION_ENABLED=true
ELYAN_UNDERSTANDING_ENVELOPE_V2_ENABLED=true
ELYAN_UNDERSTANDING_ENVELOPE_SHADOW_ENABLED=false
ELYAN_UNDERSTANDING_ENVELOPE_MODEL_FALLBACK_ENABLED=false
ELYAN_TURN_ENVELOPE_ENABLED=false
ELYAN_DIALOGUE_STATE_ENABLED=false
ELYAN_MEMORY_FABRIC_V2_ENABLED=false
ELYAN_USER_MODEL_V2_ENABLED=false
ELYAN_GOAL_STATE_V2_ENABLED=false
ELYAN_AGENT_LOOP_ENABLED=false
# Server-side connector tools (Gmail/Calendar/Drive read) via the agent loop,
# restricted to read-only connector tool_requests. Safe to enable without the
# full agent loop.
ELYAN_CONNECTOR_TOOLS_ENABLED=true
# Official @modelcontextprotocol/sdk transport + OAuth discovery/DCR. Default off
# until validated against live MCP servers; hand-written probe stays the fallback.
ELYAN_MCP_SDK_ENABLED=false
# Source-typed Gmail/Calendar/Drive/Notion/GitHub/Slack block envelopes.
# Set false to suppress these blocks while keeping connector execution and safe
# prose replies enabled. It does not create new legacy connector_result blocks.
ELYAN_SOURCE_TYPED_CONNECTOR_BLOCKS_ENABLED=true
# Emits a user-visible tool_call telemetry block (which tool, how long, result).
ELYAN_TOOL_CALL_BLOCK_ENABLED=true
# Hard-block replies until AI-data-sharing consent is granted. OFF by default
# (consent UX not wired yet); enabling it walls off all answers.
ELYAN_AI_DATA_SHARING_CONSENT_REQUIRED=false
ELYAN_AGENT_ENGINE_V2_ENABLED=false
ELYAN_AGENT_ENGINE_SHADOW_ENABLED=false
ELYAN_AGENT_ENGINE_ROLLOUT_PERCENT=0
ELYAN_AGENT_ENGINE_GLOBAL_CONCURRENCY=4
ELYAN_AGENT_ENGINE_USER_CONCURRENCY=1
ELYAN_AGENT_ENGINE_GLOBAL_BACKPRESSURE_MAX=2000
ELYAN_AGENT_ENGINE_USER_BACKPRESSURE_MAX=20
ELYAN_CONTINUOUS_LEARNING_V2_ENABLED=false
ELYAN_CONTINUOUS_LEARNING_SHADOW_ENABLED=false
ELYAN_CONTINUOUS_LEARNING_DAILY_BATCH_LIMIT=2000
ELYAN_CONTINUOUS_LEARNING_REPLAY_RATIO=20
ELYAN_WEIGHT_TRAINING_ENABLED=false
ELYAN_BEHAVIOR_LEARNING_ENABLED=true
ELYAN_CLAIM_CONFIDENCE_V1_ENABLED=false
ELYAN_CLAIM_CONFIDENCE_SHADOW_ENABLED=false
ELYAN_SELF_CHECK_MODEL_FALLBACK_ENABLED=false
ELYAN_PROACTIVE_ENGINE_ENABLED=false
ELYAN_CLOUD_VISION_ENABLED=true
ELYAN_COST_GUARD_ENABLED=false
ELYAN_MODEL_CANARY_ENABLED=false
ELYAN_MODEL_PRIMARY_ENABLED=false
ELYAN_UNDERSTANDING_DEBUG=false
