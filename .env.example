NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=http://127.0.0.1:4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/elyan_backend
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
RUNTIME_TOKEN_TTL=12h
PAIRING_TTL_MINUTES=10
OAUTH_STATE_TTL_MINUTES=15
RUNTIME_SECRET_PEPPER=change-me-too
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CORS_ORIGIN=*
